{
  "name": "nimin-electron",
  "private": true,
  "version": "1.0.0",
  "description": "Nimin: Fetish Fantasy - desktop port of the Flash text-RPG by Xadera",
  "author": "Xadera (port)",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "vite build --mode development && electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build:dir": "vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.nimin.fetishfantasy",
    "productName": "Nimin Fetish Fantasy",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nimin"
    }
  }
}
